; Engine configuration file. Hand-maintained: agents edit this as text.
config_version=5

[application]

config/name="Dacian Scrolls"
config/description="Dacia, anul 101. The Lobizi are back."
run/main_scene="res://src/main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")

[autoload]

Settings="*res://src/autoload/settings.gd"
Bus="*res://src/autoload/bus.gd"
Content="*res://src/autoload/content.gd"
Assets="*res://src/autoload/assets.gd"
Audio="*res://src/autoload/audio.gd"
Game="*res://src/autoload/game.gd"
Router="*res://src/autoload/router.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"

[gui]

common/snap_controls_to_pixels=true

[internationalization]

locale/fallback="en"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
