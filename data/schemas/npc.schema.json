{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "npc",
 "type": "object",
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^[a-z0-9_]+$"
  },
  "name_key": {
   "type": "string",
   "minLength": 1
  },
  "sprite": {
   "type": "string",
   "pattern": "^[a-z0-9_]+$"
  },
  "portrait": {
   "type": "string",
   "pattern": "^[a-z0-9_]+$"
  },
  "dialogue": {
   "type": "string",
   "pattern": "^[a-z0-9_]+$"
  },
  "recruit_class": {
   "type": "string",
   "pattern": "^[a-z0-9_]+$"
  },
  "shop": {
   "type": "string",
   "pattern": "^[a-z0-9_]+$"
  }
 },
 "required": [
  "id",
  "name_key",
  "sprite",
  "dialogue"
 ],
 "patternProperties": {
  "^_": {}
 },
 "additionalProperties": false
}
